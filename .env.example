# Local development only. Generate a long random value for deployment.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_PATH=./data/securemind.db
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=60
SECMIND_ADMIN_USERNAME=admin
# Set this before running python main.py --init-admin; never commit a real password.
SECMIND_ADMIN_PASSWORD=
